#!/usr/bin/env bash
# Regenerate the third-party attributions (app/src-tauri/binaries/licenses/) for the current
# or given target, so Settings → About lists them in `pnpm tauri dev`. See third_party.py.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --project engine --quiet python scripts/third_party.py "$@"
