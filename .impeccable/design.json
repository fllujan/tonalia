    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "Bienvenida y títulos grandes."
      },
      "headline": {
        "displayName": "Headline",
        "purpose": "Títulos de pantalla y del tema en el detalle."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Títulos de sección y de tarjeta."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Texto corrido, descripciones y guías."
      },
      "control": {
        "displayName": "Control",
        "purpose": "Tabla, botones y campos."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Encabezados de la barra lateral y etiquetas pequeñas, en mayúsculas."
      },
      "data": {
        "displayName": "Data",
        "purpose": "Tonalidad, BPM, tiempos, energía y contadores (cifras tabulares)."
      },
      "data-lg": {
        "displayName": "Data grande",
        "purpose": "BPM y tonalidad en los decks y en la cabecera del detalle."
      }
    },
    "gradients": [
      {
        "name": "aurora",
        "value": "linear-gradient(135deg, #7162E8 0%, #A44DD5 50%, #C74A6C 100%)",
        "purpose": "Único brillo de marca: logo, Probar mashup/mezcla, bienvenida, arrastre y progreso global. Máximo 1–2 usos por pantalla."
      }
    ],
    "shadows": [
      {
        "name": "overlay-dark",
        "value": "0 12px 40px rgba(0,0,0,.45)",
        "purpose": "Modales, menús, popovers y el botón aurora en modo oscuro."
      },
      {
        "name": "overlay-light",
        "value": "0 1px 2px rgba(20,18,40,.06), 0 8px 24px rgba(20,18,40,.08)",
        "purpose": "Lo mismo en modo claro; también las tarjetas."
      }
    ],
    "motion": [
      {
        "name": "duration-hover",
        "value": "150ms",
        "purpose": "Hovers y cambios de estado."
      },
      {
        "name": "duration-panel",
        "value": "220ms",
        "purpose": "Paneles deslizantes."
      },
      {
        "name": "ease-out",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Curva por defecto, sin rebotes. Con «reducir movimiento», todo a 0."
      }
    ],
    "breakpoints": [
      {
        "name": "window-min",
        "value": "1200px × 760px"
      },
      {
        "name": "window-design",
        "value": "1440px × 900px"
      }
    ]
  },
  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de cada pantalla (Analizar, Exportar, Guardar).",
      "html": "<button class=\"ds-btn-primary\">Analizar</button>",
      "css": ".ds-btn-primary{height:32px;padding:0 12px;border:0;border-radius:var(--radius-sm,6px);background:var(--color-primary);color:#fff;font:600 13px/18px var(--font-sans,'Instrument Sans Variable',system-ui,sans-serif);cursor:pointer;transition:background-color var(--duration-hover,150ms) var(--ease-out,ease-out)}.ds-btn-primary:hover{background:var(--color-primary-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}.ds-btn-primary:disabled{opacity:.4}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acciones de apoyo (Simular, Filtros, Cancelar).",
      "html": "<button class=\"ds-btn-secondary\">Simular</button>",
      "css": ".ds-btn-secondary{height:32px;padding:0 12px;border:1px solid var(--color-border);border-radius:var(--radius-sm,6px);background:var(--color-surface-3);color:var(--color-text);font:500 13px/18px var(--font-sans,'Instrument Sans Variable',system-ui,sans-serif);cursor:pointer;transition:border-color var(--duration-hover,150ms) var(--ease-out,ease-out)}.ds-btn-secondary:hover{border-color:var(--color-border-strong)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}"
    },
    {
      "name": "Botón aurora",
      "kind": "button",
      "refersTo": "button-aurora",
      "description": "Solo «Probar mashup» y «Probar mezcla»: el único brillo de marca.",
      "html": "<button class=\"ds-btn-aurora\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M6 3l14 9-14 9V3z\"/></svg>Probar mashup</button>",
      "css": ".ds-btn-aurora{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 20px;border:0;border-radius:999px;background:var(--gradient-aurora,linear-gradient(135deg,#7162e8 0%,#a44dd5 50%,#c74a6c 100%));color:#fff;font:600 13px/18px var(--font-sans,'Instrument Sans Variable',system-ui,sans-serif);letter-spacing:.04em;text-transform:uppercase;box-shadow:var(--shadow-overlay,0 12px 40px rgba(0,0,0,.45));cursor:pointer;transition:opacity var(--duration-hover,150ms) var(--ease-out,ease-out)}.ds-btn-aurora:hover{opacity:.9}.ds-btn-aurora:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input",
      "description": "Campos de formulario y filtros; los numéricos en mono.",
      "html": "<input class=\"ds-input\" placeholder=\"Buscar temas…  ⌘F\">",
      "css": ".ds-input{height:32px;width:240px;padding:0 8px;border:1px solid var(--color-border);border-radius:var(--radius-sm,6px);background:var(--color-surface-3);color:var(--color-text);font:500 13px/18px var(--font-sans,'Instrument Sans Variable',system-ui,sans-serif);outline:none}.ds-input::placeholder{color:var(--color-text-3)}.ds-input:focus{border-color:var(--color-primary)}"
    },
    {
      "name": "Chip de tonalidad",
      "kind": "chip",
      "refersTo": "key-chip",
      "description": "La tonalidad siempre escrita, en el color de su número de la rueda.",
      "html": "<span class=\"ds-key-chip\" style=\"--chip:var(--color-key-8a,#0094ce)\">8A</span> <span class=\"ds-key-chip ds-key-chip-low\" style=\"--chip:var(--color-key-9b,#90bfff)\">9B ⚠</span>",
      "css": ".ds-key-chip{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 8px;border:1px solid color-mix(in srgb,var(--chip) 60%,transparent);border-radius:999px;background:color-mix(in srgb,var(--chip) 20%,transparent);color:color-mix(in srgb,var(--chip) var(--key-text-mix,70%),var(--key-text-base,#fff));font:600 13px/18px var(--font-mono,'Martian Mono Variable',ui-monospace,monospace);font-stretch:87.5%;font-variant-numeric:tabular-nums}.ds-key-chip-low{border-style:dashed}"
    },
    {
      "name": "Medidor de energía",
      "kind": "custom",
      "refersTo": "energy-meter",
      "description": "Diez barritas de fría a caliente más el número en mono.",
      "html": "<span class=\"ds-energy\"><i style=\"background:var(--color-energy-1)\"></i><i style=\"background:var(--color-energy-2)\"></i><i style=\"background:var(--color-energy-3)\"></i><i style=\"background:var(--color-energy-4)\"></i><i style=\"background:var(--color-energy-5)\"></i><i style=\"background:var(--color-energy-6)\"></i><i style=\"background:var(--color-energy-7)\"></i><i></i><i></i><i></i><b>7</b></span>",
      "css": ".ds-energy{display:inline-flex;align-items:flex-end;gap:2px}.ds-energy i{display:block;width:3px;height:12px;border-radius:1px;background:var(--color-surface-3)}.ds-energy b{margin-left:6px;font:500 13px/12px var(--font-mono,'Martian Mono Variable',ui-monospace,monospace);font-stretch:87.5%;color:var(--color-text)}"
    },
    {
      "name": "Selector segmentado",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "Mashup | DJ Mix, Tema | Voz | Instrumental, Biblioteca | Pro.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button role=\"radio\" aria-checked=\"true\">Mashup</button><button role=\"radio\" aria-checked=\"false\">DJ Mix</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:2px;border:1px solid var(--color-border);border-radius:7px;background:var(--color-bg)}.ds-seg button{height:28px;padding:0 12px;border:0;border-radius:5px;background:transparent;color:var(--color-text-3);font:500 13px/18px var(--font-sans,'Instrument Sans Variable',system-ui,sans-serif);cursor:pointer;transition:color var(--duration-hover,150ms)}.ds-seg button:hover{color:var(--color-text)}.ds-seg button[aria-checked=true]{background:var(--color-surface-3);color:var(--color-text)}.ds-seg button:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}"
    },
    {
      "name": "Ítem de navegación",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Barra lateral: icono o emoji, nombre y contador en mono.",
