{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonalia",
  "version": "0.2.0",
  "identifier": "org.tonalia.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tonalia",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/artwork/**", "$APPDATA/waveforms/**", "$APPDATA/cache/stems/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "Music",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tonalia",
    "copyright": "© Tonalia contributors · AGPL-3.0-only",
    "shortDescription": "Mezcla en armonía · Mix in harmony",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      }
    },
    "windows": {
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NUQ4MEZGMzM1NEQ5RjIKUldUeTJWUXovNEJkOWJtTmQxWTRmWU95cmIvTlcrOTZmSU9XODN0aml3bFVoazdJa28xQ2lsOEIK",
      "endpoints": ["https://github.com/fllujan/tonalia/releases/latest/download/latest.json"]
    }
  }
}
