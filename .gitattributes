# Normalize line endings: LF in the repo and in every checkout (Windows CI included),
# so formatters (prettier, ruff, rustfmt) see the same bytes on every platform.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.icns binary
*.ico binary
*.woff binary
*.woff2 binary
